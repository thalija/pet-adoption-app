# Copy to backend/.env and adjust. Every value is optional for local development.

DJANGO_DEBUG=True
# DJANGO_SECRET_KEY=change-me
# DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Needed to register an admin account from the Register page
ADMIN_SECRET_KEY=choose-a-secret

# Leave DATABASE_URL unset to use the local SQLite database (python manage.py init_local_db)
# DATABASE_URL=postgres://user:password@host:5432/dbname
# DATABASE_SSL_REQUIRE=True

# Frontend origins allowed to call the API
# DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-frontend.example.com
